{
  "suite": "self-comparison",
  "description": "Today against the person's own recent days, for a nutrient with no target. Window: the 7 calendar days before the day (day - 7 to day - 1, inclusive), excluding the day itself; days whose total is null are skipped, not counted as 0. average = their mean rounded half-up to one decimal, null when there are none; percentOfAverage = round-half-up(total / unrounded mean x 100), null when total is null or the mean is 0.",
  "generatedBy": "pocket-nutrition-sandbox — npm run vectors:build",
  "cases": [
    {
      "id": "average-of-days-with-data",
      "why": "Salt on 8 November against 1-7 November: 31 October is outside, 3 November has no data, today is excluded; (6 + 9 + 7.5) / 3 = 7.5 and 11.25 is 150 %.",
      "input": {
        "history": [
          {
            "date": "2026-10-31",
            "total": 100
          },
          {
            "date": "2026-11-01",
            "total": 6
          },
          {
            "date": "2026-11-03",
            "total": null
          },
          {
            "date": "2026-11-05",
            "total": 9
          },
          {
            "date": "2026-11-07",
            "total": 7.5
          },
          {
            "date": "2026-11-08",
            "total": 50
          }
        ],
        "day": "2026-11-08",
        "total": 11.25
      },
      "expected": {
        "average": 7.5,
        "daysWithData": 3,
        "percentOfAverage": 150
      }
    },
    {
      "id": "no-history",
      "why": "A new user has no past days: no average and no percentage, never a comparison with zero.",
      "input": {
        "history": [],
        "day": "2026-11-08",
        "total": 5
      },
      "expected": {
        "average": null,
        "daysWithData": 0,
        "percentOfAverage": null
      }
    },
    {
      "id": "today-unknown",
      "why": "When today has no value yet the average is still shown, without a percentage.",
      "input": {
        "history": [
          {
            "date": "2026-10-31",
            "total": 100
          },
          {
            "date": "2026-11-01",
            "total": 6
          },
          {
            "date": "2026-11-03",
            "total": null
          },
          {
            "date": "2026-11-05",
            "total": 9
          },
          {
            "date": "2026-11-07",
            "total": 7.5
          },
          {
            "date": "2026-11-08",
            "total": 50
          }
        ],
        "day": "2026-11-08",
        "total": null
      },
      "expected": {
        "average": 7.5,
        "daysWithData": 3,
        "percentOfAverage": null
      }
    },
    {
      "id": "eight-days-ago-excluded",
      "why": "The window is exactly the 7 previous days: a value 8 days before does not count, so there is nothing to compare with.",
      "input": {
        "history": [
          {
            "date": "2026-10-31",
            "total": 100
          }
        ],
        "day": "2026-11-08",
        "total": 5
      },
      "expected": {
        "average": null,
        "daysWithData": 0,
        "percentOfAverage": null
      }
    },
    {
      "id": "zero-average-no-percent",
      "why": "An average of 0 would divide by zero: the average is shown as 0 and the percentage is null.",
      "input": {
        "history": [
          {
            "date": "2026-11-07",
            "total": 0
          }
        ],
        "day": "2026-11-08",
        "total": 3
      },
      "expected": {
        "average": 0,
        "daysWithData": 1,
        "percentOfAverage": null
      }
    }
  ]
}
