{
  "suite": "apply-target-overrides",
  "description": "User overrides on top of the computed targets. The override version in force on the day is the latest effectiveFrom on or before it (last in the list among equal dates); each version is a complete snapshot, so a version with no values resets everything to the computed targets. An override replaces min and max and keeps upperLimit and sources; an override on a key with no computed target adds one with unit from the key suffix (Kcal -> kcal, Ug -> µg, Mg -> mg, else g), upperLimit null and no source. Every target carries overridden; sorted by nutrientKey.",
  "generatedBy": "pocket-nutrition-sandbox — npm run vectors:build",
  "cases": [
    {
      "id": "no-override",
      "why": "Without overrides every computed target passes through unchanged, flagged overridden: false.",
      "input": {
        "targets": [
          {
            "nutrientKey": "energyKcal",
            "unit": "kcal",
            "min": 2588,
            "max": 2588,
            "upperLimit": null,
            "sources": [
              "efsa/energy"
            ]
          },
          {
            "nutrientKey": "proteinG",
            "unit": "g",
            "min": 62,
            "max": null,
            "upperLimit": null,
            "sources": [
              "efsa/protein"
            ]
          },
          {
            "nutrientKey": "zincMg",
            "unit": "mg",
            "min": 11.7,
            "max": null,
            "upperLimit": 25,
            "sources": [
              "efsa/zinc",
              "efsa/zinc-ul"
            ]
          }
        ],
        "versions": [],
        "day": "2026-11-06"
      },
      "expected": [
        {
          "nutrientKey": "energyKcal",
          "unit": "kcal",
          "min": 2588,
          "max": 2588,
          "upperLimit": null,
          "sources": [
            "efsa/energy"
          ],
          "overridden": false
        },
        {
          "nutrientKey": "proteinG",
          "unit": "g",
          "min": 62,
          "max": null,
          "upperLimit": null,
          "sources": [
            "efsa/protein"
          ],
          "overridden": false
        },
        {
          "nutrientKey": "zincMg",
